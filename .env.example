# Exemple local/dev.
# Copier ce fichier en .env puis lancer php artisan key:generate.

# Application
APP_NAME=Evolyx
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Langue
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# Logs
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Base de donnees locale
# SQLite suffit en local. Le fichier est dans database/database.sqlite.
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

# Session, cache et jobs
# Le driver database utilise les tables Laravel correspondantes.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database

# Broadcast et stockage
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Emails locaux
# En local, les emails sont ecrits dans les logs Laravel.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Frontend Vite
VITE_APP_NAME="${APP_NAME}"
