{
    "name": "evolyx",
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "lint:check": "eslint .",
        "types:check": "vue-tsc --noEmit",
        
        "docker:build": "docker compose up -d --build",
        "docker:up": "docker compose up -d",
        "docker:down": "docker compose down",
        "docker:shell": "docker exec -it evolyx-app bash",
        "docker:install": "docker compose up -d --build && docker exec evolyx-app composer install && docker exec evolyx-app npm install && docker exec evolyx-app php artisan key:generate && docker exec evolyx-app touch database/database.sqlite && docker exec evolyx-app php artisan migrate --seed",
        "dev:docker": "docker compose up -d && docker exec -it evolyx-app npm run dev -- --host=0.0.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.19.0",
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@tailwindcss/vite": "^4.1.11",
        "@types/node": "^22.13.5",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vue/eslint-config-typescript": "^14.3.0",
        "autoprefixer": "^10.4.27",
        "concurrently": "^9.0.1",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-vue": "^9.32.0",
        "postcss": "^8.5.8",
        "prettier": "^3.4.2",
        "prettier-plugin-tailwindcss": "^0.6.11",
        "tailwindcss": "^4.2.1",
        "typescript": "^5.2.2",
        "typescript-eslint": "^8.23.0",
        "vite": "^7.0.4",
        "vue-tsc": "^2.2.4"
    },
    "dependencies": {
        "@inertiajs/vue3": "^2.3.7",
        "@vueuse/core": "^12.8.2",
        "chart.js": "^4.5.1",
        "chartjs-adapter-luxon": "^1.3.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "gsap": "^3.15.0",
        "laravel-vite-plugin": "^2.0.0",
        "lucide-vue-next": "^0.468.0",
        "luxon": "^3.7.2",
        "reka-ui": "^2.6.1",
        "tailwind-merge": "^3.2.0",
        "tw-animate-css": "^1.2.5",
        "vue": "^3.5.13",
        "vue-cal": "^4.10.2",
        "vue-input-otp": "^0.3.2"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@rollup/rollup-win32-x64-msvc": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1",
        "lightningcss-win32-x64-msvc": "^1.29.1"
    }
}
