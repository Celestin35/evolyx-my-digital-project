# Exemple production.
# Copier ce fichier en .env.production sur le serveur, ou le generer via GitHub Actions.
# Les valeurs sensibles doivent venir de GitHub Secrets ou etre renseignees directement sur le serveur.

# Application
APP_NAME=Evolyx
APP_ENV=production
APP_KEY=__GITHUB_SECRET_APP_KEY__
APP_DEBUG=false
APP_URL=__GITHUB_SECRET_APP_URL__
APP_PORT=8000

# Langue
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# Logs
LOG_CHANNEL=stack
LOG_LEVEL=error

# Base de donnees production
# DB_HOST=mysql car c'est le nom du service MySQL dans docker-compose.prod.yml.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=__GITHUB_SECRET_DB_DATABASE__
DB_USERNAME=__GITHUB_SECRET_DB_USERNAME__
DB_PASSWORD=__GITHUB_SECRET_DB_PASSWORD__
MYSQL_ROOT_PASSWORD=__GITHUB_SECRET_MYSQL_ROOT_PASSWORD__

# Session, cache et jobs
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database

# Broadcast et stockage
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Emails production
# Tant que MAIL_MAILER=log, les emails ne sont pas vraiment envoyes.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=__GITHUB_SECRET_MAIL_FROM_ADDRESS__
MAIL_FROM_NAME="${APP_NAME}"

# Frontend Vite
VITE_APP_NAME="${APP_NAME}"
